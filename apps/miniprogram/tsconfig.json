{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": [
      "ES2020"
    ],
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "miniprogram-api-typings"
    ],
    "baseUrl": ".",
    "paths": {
      "@schema": [
        "../../packages/schema/src/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "../../packages/schema/src/**/*.ts"
  ]
}