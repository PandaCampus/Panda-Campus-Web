<!-- 全局筛选：七维筛选链，逐维选择，点「搜索结果」生效 -->
<view wx:if="{{visible}}" class="fs-mask" bindtap="onClose" catchtouchmove="noop">
  <view class="fs-sheet" catchtap="noop">
    <view class="fs-head">
      <text class="fs-title">全局筛选</text>
      <text class="fs-sub">按七个维度逐步筛选，快速定位你需要的内容</text>
      <view class="fs-close" hover-class="pressed" bindtap="onClose"><image class="fs-close-ic" src="/assets/icons/close.svg" /></view>
    </view>

    <!-- 筛选链：分类 → 时间 → 地点 → 状态 / 条件 → 费用 → 排序 -->
    <view class="fs-steps">
      <view class="fs-step-row">
        <block wx:for="{{steps}}" wx:key="dim" wx:if="{{index < 4}}">
          <text wx:if="{{index > 0}}" class="fs-arrow">→</text>
          <view class="fs-step {{index === step ? 'is-cur' : ''}} {{item.set && index !== step ? 'is-set' : ''}}"
                data-index="{{index}}" bindtap="onStep">{{item.text}}</view>
        </block>
      </view>
      <view class="fs-step-row">
        <block wx:for="{{steps}}" wx:key="dim" wx:if="{{index >= 4}}">
          <text wx:if="{{index > 4}}" class="fs-arrow">→</text>
          <view class="fs-step {{index === step ? 'is-cur' : ''}} {{item.set && index !== step ? 'is-set' : ''}}"
                data-index="{{index}}" bindtap="onStep">{{item.text}}</view>
        </block>
      </view>
    </view>

    <text class="fs-sec-title">{{title}}</text>
    <view class="fs-grid">
      <view wx:for="{{options}}" wx:key="value"
            class="fs-opt {{draft[steps[step].dim] === item.value ? 'is-on' : ''}} {{item.disabledReason ? 'is-off' : ''}}"
            data-value="{{item.value}}" data-reason="{{item.disabledReason}}" bindtap="onPick">{{item.text}}</view>
    </view>

    <!-- 浏览密度：双指缩放的无障碍替代入口（PRD 5.2），立即生效、不计入筛选 -->
    <view class="fs-density">
      <text class="fs-density-label">浏览密度</text>
      <view wx:for="{{densityOptions}}" wx:key="value" class="fs-seg {{density === item.value ? 'is-on' : ''}}"
            data-value="{{item.value}}" bindtap="onDensity">{{item.text}}</view>
    </view>

    <view class="fs-footer">
      <view class="fs-btn fs-reset" hover-class="pressed" bindtap="onReset">重置筛选</view>
      <view class="fs-btn fs-search" hover-class="cta-pressed" bindtap="onSearch">搜索结果</view>
    </view>
  </view>
</view>
