/* 全局筛选（七维筛选链），外观取自 design/ui/筛选机制-列表结果.webp（直接写 rpx，390 css px = 750rpx） */
.fs-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 100;
  background: rgba(0, 0, 0, 0.45);
  display: flex; flex-direction: column; justify-content: flex-end;
}
.fs-sheet {
  padding: 0 35.6rpx;
  background: var(--surface);
  border-radius: 34.6rpx 34.6rpx 0 0;
}
.fs-head { position: relative; padding-top: 42.3rpx; }
.fs-title { display: block; font-size: 38.5rpx; line-height: 53.8rpx; font-weight: 700; color: var(--ink); }
.fs-sub { display: block; margin-top: 5.8rpx; font-size: 25rpx; line-height: 38.5rpx; color: var(--text-3); }
.fs-close {
  position: absolute; right: 0; top: 42.3rpx;
  width: 57.7rpx; height: 57.7rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
.fs-close-ic { width: 28.8rpx; height: 28.8rpx; }

.fs-steps { margin-top: 30.8rpx; }
.fs-step-row { display: flex; align-items: center; justify-content: center; }
.fs-step-row + .fs-step-row { margin-top: 28.8rpx; }
.fs-step {
  width: 142.3rpx; height: 72.1rpx; line-height: 72.1rpx; border-radius: 36.1rpx;
  background: #fff4d6; text-align: center;
  font-size: 27.9rpx; font-weight: 600; color: #2a2a2a;
}
.fs-step.is-cur { background: var(--brand-yellow); color: var(--brand-yellow-ink); font-weight: 700; }
.fs-step.is-set { background: #ffe9a8; color: var(--brand-yellow-ink); }
.fs-arrow { width: 32.7rpx; text-align: center; font-size: 23.1rpx; color: #9aa0b4; }

.fs-sec-title { display: block; margin-top: 50rpx; font-size: 31.7rpx; line-height: 44.2rpx; font-weight: 700; color: var(--ink); }
.fs-grid { display: flex; flex-wrap: wrap; align-content: flex-start; margin-top: 26.9rpx; min-height: 276.9rpx; }
.fs-opt {
  width: 208.7rpx; height: 76.9rpx; line-height: 76.9rpx; margin: 0 26rpx 23.1rpx 0; box-sizing: border-box;
  border-radius: 15.4rpx; background: var(--surface-fill); text-align: center;
  font-size: 27.9rpx; color: #2a2a2a;
}
.fs-opt:nth-child(3n) { margin-right: 0; }
.fs-opt.is-on { background: #fff7dc; border: 2.9rpx solid #f5c518; line-height: 71.2rpx; font-weight: 600; }
.fs-opt.is-off { opacity: 0.45; }

.fs-density { display: flex; align-items: center; margin-top: 3.8rpx; }
.fs-density-label { margin-right: 7.7rpx; font-size: 24rpx; color: var(--text-3); }
.fs-seg {
  height: 50rpx; line-height: 50rpx; padding: 0 23.1rpx; margin-left: 15.4rpx; border-radius: 25rpx;
  background: var(--surface-fill); font-size: 24rpx; color: #5a5f73;
}
.fs-seg.is-on { background: var(--brand-yellow); color: var(--brand-yellow-ink); font-weight: 700; }

.fs-footer { display: flex; padding: 34.6rpx 0 30.8rpx; }
.fs-btn { height: 98.1rpx; line-height: 98.1rpx; border-radius: 26.9rpx; text-align: center; font-size: 30.8rpx; font-weight: 700; }
.fs-reset { flex: 163; margin-right: 23.1rpx; background: var(--surface-fill); color: var(--ink); }
.fs-search { flex: 178; background: var(--brand-yellow); color: var(--brand-yellow-ink); }
.cta-pressed { opacity: 0.85; }
