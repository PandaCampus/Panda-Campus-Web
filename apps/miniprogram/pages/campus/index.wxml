<view class="page {{viewMode === 'map' ? 'is-map' : ''}}">
  <!-- 顶部四层：默认不透明白底 -->
  <view class="header">
    <!-- 第 1 层：状态栏 + 品牌行（右侧为微信原生胶囊，由系统绘制） -->
    <view class="row-brand" style="height: {{nav.navHeight}}px;">
      <image class="brand" src="/assets/brand.svg" mode="aspectFit" style="top: {{brandTop}}px;" />
    </view>

    <!-- 第 2 层：主体与沟通 -->
    <view class="row-entity">
      <view class="avatar" hover-class="pressed">
        <text class="ph-label">缺：头像</text>
      </view>
      <text class="entity-name">林同学</text>
      <view class="entity-actions">
        <view class="hbtn hbtn-reach" hover-class="pressed">
          <view class="ic-nfc">
            <image class="ic-nfc-frame" src="/assets/icons/nfc-frame.svg" />
            <text class="ic-nfc-text">NFC</text>
          </view>
          <text>触达</text>
        </view>
        <view class="hbtn hbtn-msg" hover-class="pressed">
          <image class="ic-mail" src="/assets/icons/mail.svg" />
          <text>消息</text>
          <view class="unread-dot" wx:if="{{hasUnread}}" />
        </view>
      </view>
    </view>

    <!-- 第 3 层：搜索 + 筛选 / 地点 -->
    <view class="row-tools">
      <view class="search">
        <image class="ic-search" src="/assets/icons/search.svg" />
        <text class="search-ph">搜索就业、商家、社团、活动…</text>
      </view>
      <view class="vbtn vbtn-filter" hover-class="pressed" bindtap="onOpenFilter">
        <image class="ic-filter" src="/assets/icons/filter.svg" />
        <text>筛选</text>
      </view>
      <view class="vbtn vbtn-place {{viewMode === 'map' ? 'is-on' : ''}}" hover-class="pressed" bindtap="onTogglePlace">
        <image class="ic-pin" src="/assets/icons/pin.svg" />
        <text>地点</text>
      </view>
    </view>

    <!-- 第 4 层：分类（PRD V1.2 锁定五项） -->
    <view class="row-cats">
      <view wx:for="{{cats}}" wx:key="key"
            class="cat {{index === activeCat ? 'is-active' : ''}}"
            data-index="{{index}}" bindtap="onCat">{{item.text}}</view>
    </view>

    <!-- 条件串：只在全局筛选应用后出现 -->
    <condition-bar wx:if="{{filterApplied}}" bind:openfilter="onOpenFilter" />
  </view>

  <!-- 地图态：只替换内容视口（PRD 8.1） -->
  <view wx:if="{{viewMode === 'map'}}" class="viewport viewport-map">
    <map-view />
  </view>

  <!-- 第 5 层：内容视口（地图态以后只替换这里） -->
  <!-- 双指捏合在大卡 / 橱窗 / 列表之间切换（PRD 5.2） -->
  <scroll-view wx:else class="viewport" scroll-y enhanced show-scrollbar="{{false}}"
               scroll-into-view="{{anchorId}}" bindscroll="onFeedScroll"
               bindtouchstart="onFeedTouchStart" bindtouchmove="onFeedTouchMove" bindtouchend="onFeedTouchEnd" bindtouchcancel="onFeedTouchEnd">
    <!-- 加载中：骨架屏（几何与当前密度一致） -->
    <view wx:if="{{loading}}" class="feed-{{density}}">
      <view wx:for="{{skeletonSlots[density]}}" wx:key="*this" class="feed-item">
        <info-card skeleton density="{{density}}" />
      </view>
    </view>
    <block wx:elif="{{cards.length}}">
    <view wx:for="{{[animKey]}}" wx:for-item="k" wx:key="*this" class="feed-{{density}} feed-anim">
      <view wx:for="{{cards}}" wx:key="card_id" id="c-{{item.card_id}}" class="feed-item">
        <info-card card="{{item}}" density="{{density}}"
                   bind:open="onOpenCard" bind:media="onCardMedia" bind:action="onCardAction" />
      </view>
    </view>
    </block>
    <view wx:elif="{{error}}" class="empty">
      <text>{{error}}</text>
      <view class="empty-btn" bindtap="onRetry">重试</view>
    </view>
    <view wx:else class="empty">
      <text>没有找到符合条件的信息</text>
      <view class="empty-btn" bindtap="onClearFilters">清除筛选</view>
    </view>
  </scroll-view>

  <!-- 密度切换的状态提示：短暂、克制 -->
  <view class="dz-hint {{hintVisible ? 'is-on' : ''}}">
    <text wx:for="{{densityNames}}" wx:key="key" class="dz-seg {{item.key === density ? 'is-cur' : ''}}">{{item.text}}</text>
  </view>

  <filter-sheet visible="{{filterVisible}}" bind:close="onCloseFilter" />
</view>
