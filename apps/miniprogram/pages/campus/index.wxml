<view class="page">
  <!-- 顶部四层：默认不透明白底 -->
  <view class="header">
    <!-- 第 1 层：状态栏 + 品牌行（右侧为微信原生胶囊，由系统绘制） -->
    <view class="row-brand" style="height: {{nav.navHeight}}px;">
      <image class="brand" src="/assets/brand.svg" mode="aspectFit" style="top: {{brandTop}}px;" />
    </view>

    <!-- 第 2 层：主体与沟通 -->
    <view class="row-entity">
      <view class="avatar" hover-class="pressed">
        <text class="ph-label">缺：头像</text>
      </view>
      <text class="entity-name">林同学</text>
      <view class="entity-actions">
        <view class="hbtn hbtn-reach" hover-class="pressed">
          <view class="ic-nfc">
            <image class="ic-nfc-frame" src="/assets/icons/nfc-frame.svg" />
            <text class="ic-nfc-text">NFC</text>
          </view>
          <text>触达</text>
        </view>
        <view class="hbtn hbtn-msg" hover-class="pressed">
          <image class="ic-mail" src="/assets/icons/mail.svg" />
          <text>消息</text>
          <view class="unread-dot" wx:if="{{hasUnread}}" />
        </view>
      </view>
    </view>

    <!-- 第 3 层：搜索 + 筛选 / 地点 -->
    <view class="row-tools">
      <view class="search">
        <image class="ic-search" src="/assets/icons/search.svg" />
        <text class="search-ph">搜索就业、商家、社团、活动…</text>
      </view>
      <view class="vbtn vbtn-filter" hover-class="pressed">
        <image class="ic-filter" src="/assets/icons/filter.svg" />
        <text>筛选</text>
      </view>
      <view class="vbtn vbtn-place" hover-class="pressed">
        <image class="ic-pin" src="/assets/icons/pin.svg" />
        <text>地点</text>
      </view>
    </view>

    <!-- 第 4 层：分类（PRD V1.2 锁定五项） -->
    <view class="row-cats">
      <view wx:for="{{cats}}" wx:key="key"
            class="cat {{index === activeCat ? 'is-active' : ''}}"
            data-index="{{index}}" bindtap="onCat">{{item.text}}</view>
    </view>
  </view>

  <!-- 第 5 层：内容视口（地图态以后只替换这里） -->
  <scroll-view class="viewport" scroll-y enhanced show-scrollbar="{{false}}">
    <!-- 加载中：骨架屏（几何与当前密度一致） -->
    <view wx:if="{{loading}}" class="feed-{{density}}">
      <view wx:for="{{skeletonSlots[density]}}" wx:key="*this" class="feed-item">
        <info-card skeleton density="{{density}}" />
      </view>
    </view>
    <view wx:elif="{{cards.length}}" class="feed-{{density}}">
      <view wx:for="{{cards}}" wx:key="card_id" class="feed-item">
        <info-card card="{{item}}" density="{{density}}"
                   bind:open="onOpenCard" bind:media="onCardMedia" bind:action="onCardAction" />
      </view>
    </view>
    <view wx:elif="{{error}}" class="empty">
      <text>{{error}}</text>
      <view class="empty-btn" bindtap="onRetry">重试</view>
    </view>
    <view wx:else class="empty">
      <text>没有找到符合条件的信息</text>
      <view class="empty-btn" bindtap="onClearFilters">清除筛选</view>
    </view>
  </scroll-view>
</view>
